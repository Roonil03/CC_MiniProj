# ------------------------------------------------------------------------------
# Datasets & Experiment Outputs
# ------------------------------------------------------------------------------
# Raw and large benchmark traces / datasets (keep directory structure tracked)
datasets/raw/*
!datasets/raw/.gitkeep
!datasets/raw/README.md

datasets/processed/*
!datasets/processed/.gitkeep
!datasets/processed/README.md

# Experiment runs, telemetry traces, and simulation logs
experiments/runs/*
!experiments/runs/.gitkeep
!experiments/runs/README.md
experiments/runs/*.zip
services/prediction-service/data/*.sqlite*

# General logs & databases
*.log
logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db

