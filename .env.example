# DT-RAM Environment Configuration Template
# Copy this file to .env and configure local environment settings

# System Mode
NODE_ENV=development
LOG_LEVEL=info

# API Gateway & Backend Services
API_GATEWAY_PORT=3000
EXPERIMENT_SERVICE_PORT=3001
DT_RAM_API_KEY=replace_with_a_long_random_api_key
DT_RAM_SERVICE_TOKEN=replace_with_a_different_long_random_service_token
EXPERIMENT_SERVICE_URL=http://localhost:3001
INFRASTRUCTURE_CONTROLLER_URL=http://localhost:8081
TWIN_MANAGER_URL=http://localhost:8080
PREDICTION_SERVICE_URL=http://localhost:5000
SIMULATION_SERVICE_URL=http://localhost:5002
SAFETY_SERVICE_URL=http://localhost:5003
TWIN_MANAGER_PORT=8080
INFRASTRUCTURE_CONTROLLER_PORT=8081
TELEMETRY_AGENT_PORT=8082
PREDICTION_SERVICE_PORT=5000
RL_SERVICE_PORT=5001
SIMULATION_SERVICE_PORT=5002
SAFETY_SERVICE_PORT=5003

# Database & Storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dt_ram
POSTGRES_USER=dt_user
POSTGRES_PASSWORD=dt_password_change_me
REDIS_HOST=localhost
REDIS_PORT=6379

# Event Bus (NATS JetStream)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=dt-ram-cluster

# Prometheus & Monitoring
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# Kubernetes Configuration
KUBECONFIG_PATH=~/.kube/config
K8S_NAMESPACE=dt-ram
